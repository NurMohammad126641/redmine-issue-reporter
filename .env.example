# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Redmine (needed for `fetch` and `run`). Create the key under "My account" > "API access key".
REDMINE_URL=https://redmine.example.com
REDMINE_API_KEY=
REDMINE_PROJECT=
REDMINE_MAX_ISSUES=2000
# Only set to false for an internal server with a self-signed certificate.
REDMINE_VERIFY_SSL=true

# Email delivery (needed for `send` and `run`).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=

LOG_LEVEL=INFO
